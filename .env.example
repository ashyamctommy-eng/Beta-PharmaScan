# Copy this to .env and fill in your values.
#
# On a managed host (Railway and friends) MOST OF THIS IS INFERRED: the database, the data
# directory, where documents go, connection pooling and the AI provider are all detected from
# the environment, and anything you set here wins over the detection. In practice you provide
# the AI key, the admin credentials and the access code — see RAILWAY-DEPLOY.md.
# Railway will inject PORT automatically - do NOT set it here

# Required: the API key of the AI provider you use.
#   Groq        -> keys start with gsk_      (https://console.groq.com)
#   OpenRouter  -> keys start with sk-or-v1- (https://openrouter.ai/keys)
GROQ_API_KEY=your_api_key_here

# Optional: use a provider OTHER than Groq. Any OpenAI-compatible endpoint works;
# the app switches transports automatically. For OpenRouter, set BOTH of these:
#   GROQ_BASE_URL=https://openrouter.ai/api/v1
#   GROQ_MODEL=openai/gpt-oss-20b
# Note: OpenRouter's ":free" model variants are heavily rate-limited upstream and
# answer with 429s; the paid gpt-oss models cost a fraction of a cent per document.
# GROQ_BASE_URL=

# Optional: override default SQLite DB path
# DATABASE_URL=sqlite+aiosqlite:///./pharmascan.db

# Optional: enable debug logging
DEBUG=false

# ── Document -> short notes (optional) ────────────────────────────────────────
# Extraction needs no key and costs nothing; the AI stages run on the same Groq key.
# Model names default to GROQ_MODEL. On a free-tier key, check what your key can see
# at https://console.groq.com/settings/limits before changing these.
# GROQ_MAP_MODEL=openai/gpt-oss-20b        # outline + section expansion
# GROQ_SUMMARY_MODEL=openai/gpt-oss-120b   # final synthesis
# GROQ_SUMMARY_MAX_TOKENS=8000             # reasoning models need headroom

# SUMMARISE_ENABLED=true                   # kill switch for the whole feature
# SUMMARISE_DAILY_TOKEN_BUDGET=150000      # whole app, rolling 24h - this protects your key
# SUMMARISE_PER_IP_DAILY_TOKENS=30000      # per client, rolling 24h
# SUMMARISE_CALLS_PER_REQUEST=3            # model calls per HTTP request (keep the host happy)
# SUMMARISE_CONCURRENCY=3                  # sections expanded in parallel per tick (1 = strictly sequential)
# SUMMARISE_MAX_SECTIONS=24                # ceiling on sections expanded per run

# Only needed when routing Groq through a proxy/gateway:
# GROQ_BASE_URL=

# ── Admin panel ───────────────────────────────────────────────────────────────
# With NEITHER of these set the panel stays closed (there is no default password).
# Preferred: a hash, so the plaintext never sits in a file.
#   python -m core.auth hash      -> paste the result into ADMIN_PASSWORD_HASH
# ADMIN_PASSWORD_HASH=scrypt$16384$8$1$...
# Quicker: plaintext, hashed in memory at startup.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=choose-something-long
# Optional but recommended: a fixed session-signing secret (python -m core.auth secret).
# Without it the secret is derived from the password, so changing the password
# signs everyone out — which is usually what you want.
# SESSION_SECRET=
# ADMIN_SESSION_HOURS=12

# ── Access gate for the AI features ───────────────────────────────────────────
# Blank = /api/analyze and /api/summarise are open (token budgets still apply).
# Set a code (or set it in the panel) and students unlock once per device.
# ACCESS_CODE=
# ANALYZE_ENABLED=true
