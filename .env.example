# Copy this to .env and fill in your values
# Railway will inject PORT automatically - do NOT set it here

# Required: Groq API key (get free key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Optional: override default SQLite DB path
# DATABASE_URL=sqlite+aiosqlite:///./pharmascan.db

# Optional: enable debug logging
DEBUG=false

# ── Document -> short notes (optional) ────────────────────────────────────────
# Extraction needs no key and costs nothing; the AI stages run on the same Groq key.
# Model names default to GROQ_MODEL. On a free-tier key, check what your key can see
# at https://console.groq.com/settings/limits before changing these.
# GROQ_MAP_MODEL=openai/gpt-oss-20b        # outline + section expansion
# GROQ_SUMMARY_MODEL=openai/gpt-oss-120b   # final synthesis
# GROQ_SUMMARY_MAX_TOKENS=8000             # reasoning models need headroom

# SUMMARISE_ENABLED=true                   # kill switch for the whole feature
# SUMMARISE_DAILY_TOKEN_BUDGET=150000      # whole app, rolling 24h - this protects your key
# SUMMARISE_PER_IP_DAILY_TOKENS=30000      # per client, rolling 24h
# SUMMARISE_CALLS_PER_REQUEST=3            # model calls per HTTP request (keep the host happy)
# SUMMARISE_MAX_SECTIONS=24                # ceiling on sections expanded per run

# Only needed when routing Groq through a proxy/gateway:
# GROQ_BASE_URL=
